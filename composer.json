{
    "name": "paulomilagre/catalogo-toyota",
    "description": "Catálogo Toyota com agendamento de test-drive (Trabalhos Individuais I e II de SCOM).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Toyota\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toyota\\Testes\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unitarios": "phpunit --testsuite unitarios",
        "test:integracao": "phpunit --testsuite integracao"
    },
    "config": {
        "sort-packages": true
    }
}
