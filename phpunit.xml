<?xml version="1.0" encoding="UTF-8"?>
<!--
  Testes automatizados. Para rodar:
    php tools/phpunit.phar            (todos)
    php tools/phpunit.phar --testsuite unitarios
  ou, com Composer instalado: composer test
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         testdox="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="unitarios">
            <directory>tests/Unitarios</directory>
        </testsuite>
        <testsuite name="integracao">
            <directory>tests/Integracao</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
