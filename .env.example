# Copie este arquivo para ".env" e ajuste os valores.
# O .env NÃO vai para o Git (está no .gitignore), porque guarda senhas.

# desenvolvimento | producao
APP_ENV=desenvolvimento
# true mostra detalhes técnicos dos erros 500 (só vale com APP_ENV=desenvolvimento)
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

# Banco de dados (no XAMPP o usuário padrão é root, sem senha)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=catalogo_toyota
DB_USER=root
DB_PASS=

# Banco usado pelos testes de integração (é apagado e recriado a cada execução)
DB_NAME_TESTE=catalogo_toyota_teste

# Caminho do arquivo de log (relativo à pasta do projeto)
LOG_ARQUIVO=logs/app.log

# true quando o site estiver em HTTPS (cookie de sessão só trafega cifrado)
SESSION_SECURE=false
